pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                // Get some code from a GitHub repository
                git 'https://github.com/santhoshawsgit/Hotstar-App.git'
                
             
                // build docker image from docker file
                sh "docker build -t hotstar ."

               //remove hotcontainer if already present
                sh "docker rm -f hotcontainer || true"

               //up the container 
               sh "docker run -itd --name hotcontainer -p 8080:8081 hotstar"
            }
        }
    }

}
