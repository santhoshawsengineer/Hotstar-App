pipeline {
    agent any

    environment {
        IMAGE_NAME = "hotstar"
        IMAGE_TAG = "v${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'docker', url: 'https://github.com/santhoshawsgit/Hotstar-App.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Build Docker image with Jenkins build number as tag
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Update Deployment YAML') {
            steps {
                script {
                    // Update image line inside deployment.yaml file
                    sh """
                        sed -i 's|image: ${IMAGE_NAME}.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|g' k8s/deployment.yaml
                    """
                    echo "✅ Updated deployment.yaml with image tag: ${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }
    }
}
